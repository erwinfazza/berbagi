# Lokasi file database SQLite lokal (opsional; adapter lokal).
# Default: ./.data/ruang-tugas.db
DATABASE_PATH=./.data/ruang-tugas.db

# Supabase project settings (gunakan URL + anon/publishable key di aplikasi).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
